{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.cjs" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "functions": {
    "api/index.cjs": {
      "maxDuration": 10,
      "includeFiles": "backend/**"
    }
  }
}
